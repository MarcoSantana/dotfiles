[Unit]
Description=Neomacs Daemon (neomacs)

[Service]
Type=forking
Environment=PATH=/home/msantana/.nvm/versions/node/v24.14.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/neomacs --init-directory /home/msantana/.emacs.d.firemacs --daemon=neomacs
ExecStop=/usr/bin/neomacsclient -s neomacs --eval "(kill-emacs)"
Restart=always

[Install]
WantedBy=default.target
